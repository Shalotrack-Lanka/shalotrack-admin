# ─── Version control ───────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ─── Environment files — NEVER bake secrets into an image ──────────
.env
.env.*
!.env.example

# ─── Local dev dependencies (rebuilt inside image from lockfiles) ───
node_modules/
vendor/

# ─── Frontend build artifacts (rebuilt inside image) ───────────────
public/hot
public/build

# ─── Laravel runtime cache (generated inside image by artisan cmds) ─
bootstrap/cache/*.php
storage/logs/*.log
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
storage/framework/testing/

# ─── Test & dev tooling ─────────────────────────────────────────────
tests/
.phpunit.cache
phpunit.xml
phpunit.xml.dist

# ─── IDE & OS noise ─────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo

# ─── Docker files themselves ─────────────────────────────────────────
Dockerfile
docker-compose*.yml
.dockerignore

# ─── CI/CD & IaC — not needed inside the container ──────────────────
.github/
.gitlab-ci.yml
.terragrunt/
terragrunt.hcl

# ─── Documentation & readme ─────────────────────────────────────────
*.md
README*
CHANGELOG*
LICENSE*

# ─── Local SSL certs or keys that should never go near an image ─────
*.pem
*.key
*.crt
*.p12