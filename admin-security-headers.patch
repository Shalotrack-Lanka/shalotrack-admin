index 0000000..669a03c
--- /dev/null
+++ b/app/Http/Controllers/Api/CspReportController.php
@@ -0,0 +1,52 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Http\Controllers\Controller;
+use App\Support\CspReport;
+use Illuminate\Http\Request;
+use Illuminate\Http\Response;
+use Illuminate\Support\Facades\Cache;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\RateLimiter;
+
+/**
+ * Receives Content-Security-Policy violation reports from browsers (POST /api/csp-report).
+ *
+ * Public on purpose: browsers send reports without cookies, so anyone can post here. That makes it a place
+ * an attacker could try to fill the log or the disk, hence the layers below, cheapest check first:
+ *   1. per-IP limit on the route (throttle middleware),
+ *   2. a global per-minute cap and a global per-day cap (the per-IP limit alone is not enough because the
+ *      client IP is taken from X-Forwarded-For and trustProxies('*') lets a client pick it),
+ *   3. identical reports (same directive, blocked URL, page and script) are logged once per hour,
+ *   4. CspReport keeps only a fixed set of short, sanitised fields.
+ * It always answers 204: the browser does not read the answer and a prober learns nothing.
+ */
+class CspReportController extends Controller
+{
+    public function __invoke(Request $request): Response
+    {
+        $noContent = response('', 204);
+
+        if (! RateLimiter::attempt('csp-report:minute', (int) config('security.csp.report_max_per_minute', 120), fn () => true, 60)) {
+            return $noContent;
+        }
+
+        foreach (CspReport::parse($request->getContent()) as $row) {
+            $fingerprint = 'csp-report:seen:' . md5(implode('|', [$row['directive'], $row['blocked'], $row['document'], $row['source'], $row['line']]));
+
+            // add() is false when the same report was already logged in the last hour.
+            if (! Cache::add($fingerprint, 1, 3600)) {
+                continue;
+            }
+
+            if (! RateLimiter::attempt('csp-report:day', (int) config('security.csp.report_max_per_day', 20000), fn () => true, 86400)) {
+                break;
+            }
+
+            Log::channel('csp')->warning('csp-violation', $row);
+        }
+
+        return $noContent;
+    }
+}
diff --git a/app/Http/Middleware/SecurityHeaders.php b/app/Http/Middleware/SecurityHeaders.php
new file mode 100644
index 0000000..73666b6
--- /dev/null
+++ b/app/Http/Middleware/SecurityHeaders.php
@@ -0,0 +1,79 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Support\SecurityHeaderPolicy;
+use Closure;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Vite;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Adds the browser-hardening response headers (config/security.php explains each one).
+ *
+ * Registered as GLOBAL middleware (not in the 'web' group) so that a 404 for an unknown URL, a 500 error page,
+ * the health check and the JSON endpoints are covered as well. Headers a controller already set are left alone.
+ */
+class SecurityHeaders
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        if (! config('security.headers.enabled')) {
+            return $next($request);
+        }
+
+        // One nonce per request. @vite() puts it on its own tags; a view that needs an inline script writes
+        // <script nonce="{{ Vite::cspNonce() }}"> and it is then allowed by the policy.
+        $nonce = SecurityHeaderPolicy::nonce();
+        Vite::useCspNonce($nonce);
+
+        $response = $next($request);
+
+        $this->apply($response, $nonce);
+
+        return $response;
+    }
+
+    private function apply(Response $response, string $nonce): void
+    {
+        $headers = $response->headers;
+
+        $set = static function (string $name, ?string $value) use ($headers): void {
+            if ($value !== null && $value !== '' && ! $headers->has($name)) {
+                $headers->set($name, $value);
+            }
+        };
+
+        $set('X-Content-Type-Options', 'nosniff');
+        $set('X-Frame-Options', config('security.headers.x_frame_options'));
+        $set('Referrer-Policy', config('security.headers.referrer_policy'));
+        $set('Permissions-Policy', config('security.headers.permissions_policy'));
+        $set('Strict-Transport-Security', SecurityHeaderPolicy::hsts((int) config('security.headers.hsts_max_age')));
+
+        // CSP only means something for pages. A response with no Content-Type yet (error pages are not
+        // prepared at this point) is a page; JSON, PDFs and downloads are not.
+        $type = strtolower((string) $headers->get('Content-Type', ''));
+
+        if ($type !== '' && ! str_starts_with($type, 'text/html')) {
+            return;
+        }
+
+        $mode = SecurityHeaderPolicy::mode(config('security.csp.mode'));
+
+        if ($mode === SecurityHeaderPolicy::MODE_OFF) {
+            return;
+        }
+
+        $policy = SecurityHeaderPolicy::csp(
+            (array) config('security.csp.directives'),
+            $nonce,
+            (bool) config('security.csp.allow_unsafe_eval'),
+            config('security.csp.report_uri'),
+        );
+
+        $set(
+            $mode === SecurityHeaderPolicy::MODE_ENFORCE ? 'Content-Security-Policy' : 'Content-Security-Policy-Report-Only',
+            $policy,
+        );
+    }
+}
diff --git a/app/Support/CspReport.php b/app/Support/CspReport.php
new file mode 100644
index 0000000..64e7fc8
--- /dev/null
+++ b/app/Support/CspReport.php
@@ -0,0 +1,104 @@
+<?php
+
+namespace App\Support;
+
+/**
+ * Turns the body a browser POSTs to /api/csp-report into small, safe rows for the log.
+ *
+ * The body comes from an anonymous request, so it is treated as hostile: only a fixed list of fields is kept,
+ * every value is cut to a short length, control characters are removed (no forged log lines), and the query
+ * string / fragment of every URL is dropped (a URL can carry a token or an id). The page's text is never
+ * kept: the policy does not ask the browser for script samples.
+ *
+ * Two body shapes exist: the classic report-uri one {"csp-report": {...}} (what Chrome, Firefox and Safari
+ * send for the report-uri directive) and the Reporting API one [{"type":"csp-violation","body":{...}}].
+ */
+final class CspReport
+{
+    private const MAX_BODY_BYTES = 16384;
+    private const MAX_ROWS       = 10;
+    private const MAX_FIELD      = 300;
+
+    /**
+     * @return list<array{directive: string, blocked: string, document: string, source: string, line: int, disposition: string}>
+     */
+    public static function parse(string $raw): array
+    {
+        if ($raw === '' || strlen($raw) > self::MAX_BODY_BYTES) {
+            return [];
+        }
+
+        $data = json_decode($raw, true, 8);
+
+        if (! is_array($data)) {
+            return [];
+        }
+
+        $reports = [];
+
+        if (isset($data['csp-report']) && is_array($data['csp-report'])) {
+            $r = $data['csp-report'];
+            $reports[] = [
+                'directive'   => $r['effective-directive'] ?? $r['violated-directive'] ?? null,
+                'blocked'     => $r['blocked-uri'] ?? null,
+                'document'    => $r['document-uri'] ?? null,
+                'source'      => $r['source-file'] ?? null,
+                'line'        => $r['line-number'] ?? 0,
+                'disposition' => $r['disposition'] ?? null,
+            ];
+        } elseif (array_is_list($data)) {
+            foreach (array_slice($data, 0, self::MAX_ROWS) as $entry) {
+                if (! is_array($entry) || ($entry['type'] ?? null) !== 'csp-violation' || ! is_array($entry['body'] ?? null)) {
+                    continue;
+                }
+                $b = $entry['body'];
+                $reports[] = [
+                    'directive'   => $b['effectiveDirective'] ?? $b['violatedDirective'] ?? null,
+                    'blocked'     => $b['blockedURL'] ?? null,
+                    'document'    => $b['documentURL'] ?? null,
+                    'source'      => $b['sourceFile'] ?? null,
+                    'line'        => $b['lineNumber'] ?? 0,
+                    'disposition' => $b['disposition'] ?? null,
+                ];
+            }
+        }
+
+        $rows = [];
+
+        foreach ($reports as $r) {
+            $directive = self::clean($r['directive'], 60);
+
+            if ($directive === '') {
+                continue; // not a usable violation report
+            }
+
+            $rows[] = [
+                'directive'   => $directive,
+                'blocked'     => self::clean($r['blocked'], self::MAX_FIELD, true),
+                'document'    => self::clean($r['document'], self::MAX_FIELD, true),
+                'source'      => self::clean($r['source'], self::MAX_FIELD, true),
+                'line'        => is_numeric($r['line']) ? max(0, min(10000000, (int) $r['line'])) : 0,
+                'disposition' => self::clean($r['disposition'], 12),
+            ];
+        }
+
+        return $rows;
+    }
+
+    private static function clean(mixed $value, int $max, bool $isUrl = false): string
+    {
+        if (! is_scalar($value)) {
+            return '';
+        }
+
+        $s = (string) $value;
+
+        if ($isUrl) {
+            $s = preg_replace('/[?#].*$/s', '', $s) ?? '';
+        }
+
+        $s = preg_replace('/[\x00-\x1F\x7F]/', '', $s) ?? '';
+
+        return mb_substr($s, 0, $max);
+    }
+}
diff --git a/app/Support/SecurityHeaderPolicy.php b/app/Support/SecurityHeaderPolicy.php
new file mode 100644
index 0000000..80be077
--- /dev/null
+++ b/app/Support/SecurityHeaderPolicy.php
@@ -0,0 +1,58 @@
+<?php
+
+namespace App\Support;
+
+/**
+ * Builds the security header values. Plain PHP on purpose (no framework calls) so the rules can be unit
+ * tested and reasoned about on their own; App\Http\Middleware\SecurityHeaders only wires them to responses.
+ */
+final class SecurityHeaderPolicy
+{
+    public const MODE_REPORT_ONLY = 'report-only';
+    public const MODE_ENFORCE     = 'enforce';
+    public const MODE_OFF         = 'off';
+
+    /** A fresh random nonce for one response (base64, as the CSP spec expects). */
+    public static function nonce(): string
+    {
+        return base64_encode(random_bytes(16));
+    }
+
+    /** Anything unknown falls back to report-only: never silently enforcing, never silently off. */
+    public static function mode(mixed $value): string
+    {
+        $value = is_string($value) ? strtolower(trim($value)) : '';
+
+        return in_array($value, [self::MODE_ENFORCE, self::MODE_OFF], true) ? $value : self::MODE_REPORT_ONLY;
+    }
+
+    /**
+     * @param  array<string, list<string>>  $directives  e.g. ['script-src' => ["'self'", "'nonce-{nonce}'"]]
+     */
+    public static function csp(array $directives, string $nonce, bool $allowUnsafeEval, ?string $reportUri): string
+    {
+        $parts = [];
+
+        foreach ($directives as $name => $sources) {
+            $sources = array_map(static fn (string $s): string => str_replace('{nonce}', $nonce, $s), array_values($sources));
+
+            if ($name === 'script-src' && $allowUnsafeEval) {
+                $sources[] = "'unsafe-eval'";
+            }
+
+            $parts[] = trim($name . ' ' . implode(' ', $sources));
+        }
+
+        if ($reportUri !== null && $reportUri !== '') {
+            $parts[] = 'report-uri ' . $reportUri;
+        }
+
+        return implode('; ', $parts);
+    }
+
+    /** Strict-Transport-Security value, or null when disabled (max-age 0 or negative). */
+    public static function hsts(int $maxAge): ?string
+    {
+        return $maxAge > 0 ? 'max-age=' . $maxAge : null;
+    }
+}
